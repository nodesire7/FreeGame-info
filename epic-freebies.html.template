<style>
:root {
    color-scheme:light;
    --ink:#17243a;
    --muted:#53627a;
    --line:#d5dce5;
    --accent:#254bac;
    --paper:#fff;
    --canvas:#f2f5f8;
    --nav:#18283c;
}

* {
    box-sizing:border-box;
}

body {
    margin:0;
    background:var(--canvas);
    color:var(--ink);
    font:16px/1.65 "Inter","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
}

a {
    color:var(--accent);
    text-underline-offset:3px;
}

button,summary {
    font:inherit;
    cursor:pointer;
}

:focus-visible {
    outline:3px solid #df731f;
    outline-offset:3px;
}

.wrap {
    width:min(1180px,calc(100% - 72px));
    margin-inline:auto;
}

.top {
    background:var(--nav);
    color:white;
}

.top .wrap,.top nav,.brand,.mast,.archive-heading {
    display:flex;
    align-items:center;
}

.top .wrap {
    min-height:60px;
    justify-content:space-between;
    gap:20px;
}

.brand {
    color:white;
    gap:9px;
    font:bold 19px/1.2 "Archivo Black",Arial,sans-serif;
    letter-spacing:.01em;
    text-decoration:none;
}

.brand img {
    border-radius:6px;
}

.top nav {
    gap:24px;
}

.top nav a {
    color:#ced7e5;
    text-decoration:none;
    font-size:14px;
}

.top a[aria-current],.top a:hover {
    color:#fff;
    text-decoration:underline;
    text-decoration-color:#eab667;
    text-underline-offset:7px;
}

.mast {
    position:relative;
    justify-content:space-between;
    gap:24px;
    padding:38px 0 32px;
    border-bottom:1px solid #acbbc9;
}

.mast h1 {
    font-size:clamp(36px,4.6vw,64px);
    line-height:1.18;
    letter-spacing:-.055em;
    margin:0;
    font-weight:850;
}

.mast p,.offer-group header p {
    color:var(--muted);
    margin:10px 0 0;
}

.mast-meta {
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:7px;
    white-space:nowrap;
}

.mast-meta small,.archive-heading>span {
    font-size:13px;
    color:var(--muted);
}

.share-button {
    font-size:14px;
    color:var(--ink);
    background:white;
    border:1px solid #bcc7d4;
    border-radius:5px;
    font-weight:650;
    text-decoration:none;
    padding:7px 15px;
}

.share-button:hover {
    border-color:var(--accent);
    color:var(--accent);
}

[aria-disabled=true] {
    pointer-events:none;
    opacity:.55;
}

.browse {
    display:grid;
    grid-template-columns:185px minmax(0,1fr);
    align-items:start;
    gap:38px;
    padding-top:30px;
}

.directory {
    position:sticky;
    top:18px;
}

.directory h2,.archive-heading h2 {
    margin:0;
    font-size:18px;
    letter-spacing:-.025em;
}

.directory h2 small {
    font-size:12px;
    color:var(--muted);
    font-weight:500;
    margin-left:9px;
}

.platform-tabs {
    display:grid;
    gap:3px;
    margin-top:12px;
}

.epic-freebies__tab {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    border:0;
    border-radius:5px;
    background:transparent;
    color:var(--muted);
    padding:10px 12px;
    text-align:left;
    font-size:15px;
    font-weight:600;
    line-height:1.4;
}

.epic-freebies__tab b {
    font-size:12px;
    font-variant-numeric:tabular-nums;
    min-width:20px;
    text-align:center;
    font-weight:600;
}

.epic-freebies__tab:hover {
    background:#e0e6ed;
}

.epic-freebies__tab.is-active {
    color:white;
    background:#26476d;
}

.epic-freebies__tab.is-active b {
    color:#d9e9ff;
}

.hidden {
    display:none!important;
}

.panel-source,.source,.offer-byline,.offer-foot,footer.wrap {
    display:flex;
    align-items:center;
    gap:12px;
}

.panel-source {
    justify-content:space-between;
    flex-wrap:wrap;
    gap:4px 12px;
    padding:0 0 12px;
    border-bottom:1px solid var(--line);
}

.panel-source>strong {
    font-size:16px;
    color:var(--muted);
}

.source {
    font-size:12px;
    flex-wrap:wrap;
    gap:4px 12px;
    color:var(--muted);
}

.source a {
    text-decoration:none;
}

.source a:hover,footer a:hover {
    text-decoration:underline;
}

.source span:empty {
    display:none;
}

.offer-group {
    margin:24px 0 36px;
}

.offer-group header {
    margin-bottom:16px;
}

.offer-group h2 {
    font-size:clamp(22px,2.5vw,32px);
    line-height:1.3;
    letter-spacing:-.04em;
    margin:0;
}

.offer-group h2 small {
    font-size:13px;
    color:var(--muted);
    font-weight:500;
    letter-spacing:normal;
    margin-left:12px;
    white-space:nowrap;
}

.offer-group header p {
    font-size:14px;
    margin-top:5px;
}

.offer {
    display:grid;
    grid-template-columns:minmax(155px,29%) minmax(0,1fr);
    border:1px solid var(--line);
    border-radius:9px;
    background:var(--paper);
    margin:10px 0;
    padding:14px;
    gap:20px;
    align-items:start;
}

.art {
    overflow:hidden;
    aspect-ratio:16/9;
    display:grid;
    place-items:center;
    background:#dfe6ef;
    border-radius:5px;
    color:#4f6079;
    font-size:13px;
}

.art img {
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
}

.offer-copy {
    min-width:0;
    overflow-wrap:anywhere;
}

.offer h3 {
    font-size:clamp(19px,2vw,25px);
    line-height:1.3;
    letter-spacing:-.025em;
    margin:6px 0;
}

.offer-byline {
    font-size:12px;
    color:var(--muted);
    gap:8px;
}

.condition {
    font-weight:650;
    padding:1px 7px;
    border-radius:3px;
}

.available {
    color:#1a6548;
    background:#e1f2e8;
}

.upcoming {
    color:#80501d;
    background:#fcf0d8;
}

.bundle {
    color:#754171;
    background:#f5e6f1;
}

.member {
    color:#484e98;
    background:#e9ebfc;
}

.description {
    color:#384860;
    line-height:1.65;
    font-size:15px;
    margin:7px 0;
    max-width:75ch;
}

.facts {
    display:flex;
    gap:3px 14px;
    flex-wrap:wrap;
    margin:8px 0;
    font-size:13px;
}

.facts div {
    display:flex;
    gap:5px;
    align-items:baseline;
}

.facts dt {
    color:var(--muted);
}

.facts dd {
    margin:0;
}

.more {
    font-size:13px;
    color:var(--muted);
    margin:7px 0;
}

.more .facts {
    background:#f4f6f8;
    padding:8px;
}

.offer-foot {
    border-top:1px solid #e3e8ef;
    justify-content:space-between;
    margin-top:11px;
    padding-top:10px;
    flex-wrap:wrap;
    gap:6px;
}

.store-link {
    font-size:13px;
    font-weight:650;
    white-space:nowrap;
    text-decoration:none;
}

.store-link:hover {
    text-decoration:underline;
}

.window {
    font-size:13px;
    color:#34445b;
    font-variant-numeric:tabular-nums;
}

.timer {
    display:block;
    color:var(--muted);
    font-size:12px;
}

.empty {
    border-left:3px solid #bdc8d5;
    background:white;
    color:var(--muted);
    padding:16px 18px;
    font-size:15px;
}

.advert {
    margin:12px 0;
    text-align:center;
    color:var(--muted);
    font-size:12px;
}

.advert:not(:has(iframe)):not(:has(ins)) {
    margin:0;
}

.mobile-ad {
    display:none;
}

footer.wrap {
    margin-top:26px;
    border-top:1px solid var(--line);
    padding:18px 0 32px;
    flex-wrap:wrap;
    gap:6px 18px;
    color:var(--muted);
    font-size:13px;
}

footer a {
    color:var(--muted);
    text-decoration:none;
}

.archive {
    max-width:1000px;
}

.archive-heading {
    margin:24px 0 12px;
    justify-content:space-between;
    gap:14px;
}

.record {
    background:white;
    border:1px solid var(--line);
    border-radius:7px;
    margin:7px 0;
}

.record>summary {
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 20px;
    gap:10px;
    list-style:none;
}

.record>summary::-webkit-details-marker {
    display:none;
}

.record>summary:before {
    content:'▸';
    color:var(--accent);
}

.record[open]>summary:before {
    content:'▾';
}

.record>summary strong {
    flex:1;
    font-variant-numeric:tabular-nums;
}

.record>summary span {
    font-size:13px;
    color:var(--muted);
}

.archive-platform {
    padding:14px 20px 0;
}

.archive-platform .offer-group {
    margin:16px 0 22px;
}

.archive-platform h2 {
    font-size:21px;
}

@media(max-width:900px) {
    .wrap {
        width:calc(100% - 40px);
    }
    .browse {
        grid-template-columns:145px minmax(0,1fr);
        gap:22px;
    }
    .offer {
        grid-template-columns:minmax(120px,26%) minmax(0,1fr);
        gap:15px;
    }
}

@media(max-width:720px) {
    .wrap {
        width:calc(100% - 32px);
    }
    .top .wrap {
        min-height:52px;
    }
    .brand {
        font-size:16px;
    }
    .brand img {
        width:24px;
        height:24px;
    }
    .top nav {
        gap:12px;
    }
    .top nav a {
        font-size:12px;
    }
    .mast {
        display:block;
        padding:26px 0 20px;
    }
    .mast h1 {
        font-size:39px;
    }
    .mast p {
        font-size:14px;
    }
    .mast-meta {
        margin-top:15px;
        flex-direction:row;
        justify-content:space-between;
        align-items:center;
        gap:8px;
    }
    .mast-meta small {
        font-size:12px;
    }
    .share-button {
        font-size:13px;
        padding:5px 10px;
    }
    .browse {
        display:block;
        padding-top:17px;
    }
    .directory {
        position:static;
        margin-bottom:22px;
    }
    .directory h2 {
        font-size:15px;
    }
    .platform-tabs {
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:4px;
        margin-top:7px;
    }
    .epic-freebies__tab {
        font-size:13px;
        padding:7px 9px;
        background:#e6ebf1;
    }
    .offer-group {
        margin:16px 0 26px;
    }
    .offer {
        grid-template-columns:1fr;
        padding:0;
        gap:0;
        overflow:hidden;
    }
    .offer-copy {
        padding:13px 15px;
    }
    .art {
        border-radius:0;
        max-height:220px;
    }
    .offer h3 {
        font-size:21px;
    }
    .desktop-ad {
        display:none;
    }
    .mobile-ad {
        display:block;
    }
    .archive-platform {
        padding:10px;
    }
    .archive-heading {
        flex-wrap:wrap;
    }
}

@media(max-width:400px) {
    .platform-tabs { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(prefers-reduced-motion:reduce) {
    *,*:before,*:after {
        scroll-behavior:auto!important;
    }
}

.component-state {
    display:block;
    font-size:12px;
}

.offer-byline a {
    color:inherit;
    text-decoration:underline;
}

@media(max-width:720px) {
    .epic-freebies__tab {
        gap:3px;
    }
    .epic-freebies__tab b {
        min-width:10px;
    }
}
</style><noscript><style>.platform-tabs{display:none}.epic-freebies__panel.hidden{display:block!important}</style></noscript></head>

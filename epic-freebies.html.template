<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>白嫖游戏速报 | GBTGAME官方网站</title>
    <link rel="icon" type="image/png" href="logo.png">
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9956808351564739" crossorigin="anonymous"></script>
    <!-- AMP Auto Ads -->
    <script async custom-element="amp-auto-ads" src="https://cdn.ampproject.org/v0/amp-auto-ads-0.1.js"></script>
    <!-- Tailwind CSS CDN with config -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'steam-bg': '#0a151f',
                        'steam-bg-deep': '#060e17',
                        'steam-bg-panel': '#0b1826',
                        'steam-text': '#f3f6fb',
                        'steam-text-muted': '#9bb5d0',
                        'steam-accent': '#66c0f4',
                        'steam-accent-strong': '#1994d6',
                    },
                    borderRadius: {
                        'steam-xl': '28px',
                        'steam-lg': '20px',
                        'steam-md': '14px',
                    },
                    fontFamily: {
                        'steam': '"Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif',
                    },
                    spacing: {
                        'steam-section-gap': '28px',
                    },
                    backgroundImage: {
                        'steam-body': 'radial-gradient(120% 80% at 10% 10%, rgba(102, 192, 244, 0.18), transparent 65%), linear-gradient(160deg, #060e17 0%, #0b1826 40%, #02070d 100%)',
                        'steam-hero': 'linear-gradient(135deg, rgba(17, 28, 42, 0.95), rgba(9, 15, 24, 0.9)), linear-gradient(145deg, rgba(19, 126, 207, 0.22), transparent 65%)',
                        'steam-card': 'linear-gradient(180deg, rgba(16, 28, 43, 0.92), rgba(11, 18, 29, 0.9))',
                        'steam-section': 'linear-gradient(145deg, rgba(10, 19, 29, 0.92), rgba(6, 12, 21, 0.9))',
                        'steam-accent-gradient': 'linear-gradient(135deg, rgba(102, 192, 244, 0.25), rgba(102, 192, 244, 0.05))',
                    },
                    boxShadow: {
                        'steam-card': '0 24px 45px rgba(4, 8, 16, 0.55)',
                        'steam-card-hover': '0 36px 70px rgba(4, 8, 16, 0.7)',
                        'steam-hero': '0 40px 80px rgba(5, 10, 18, 0.55)',
                        'steam-section': '0 32px 70px rgba(4, 9, 16, 0.6)',
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
            background: radial-gradient(45% 60% at 10% 10%, rgba(102, 192, 244, 0.18), transparent 60%),
                        radial-gradient(30% 40% at 80% 0%, rgba(19, 126, 207, 0.18), transparent 70%),
                        linear-gradient(160deg, #060e17 0%, #0b1826 40%, #02070d 100%);
            -webkit-font-smoothing: antialiased;
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .countdown-tick {
            animation: countdown-pulse 0.3s ease-out;
        }
        @keyframes countdown-pulse {
            0% { opacity: 0.6; transform: scale(0.98); }
            100% { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body class="m-0 min-h-screen text-steam-text antialiased">
    <!-- AMP Auto Ads -->
    <amp-auto-ads type="adsense" data-ad-client="ca-pub-9956808351564739"></amp-auto-ads>

    <div class="relative min-h-screen py-10 lg:py-14">
        <div class="mx-auto max-w-[1180px] px-4 lg:px-8">

            <!-- Hero Section -->
            <header class="relative overflow-hidden rounded-steam-xl bg-steam-hero border border-steam-accent/20 shadow-steam-hero flex flex-col gap-5 p-8 lg:p-14 mb-10">
                <div class="absolute inset-0 -z-10 opacity-60 bg-[radial-gradient(145deg,rgba(19,126,207,0.22),transparent_65%)]"></div>
                <div class="relative z-10 flex flex-col gap-4 max-w-xl">
                    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase">
                        Game Freebie Radar
                    </span>
                    <h1 class="text-3xl lg:text-[46px] font-bold tracking-wide m-0">白嫖游戏信息</h1>
                    <p class="text-steam-text-muted text-sm lg:text-base leading-relaxed max-w-lg m-0">聚合 EPIC | Steam | PlayStation | ITAD Giveaways 限免信息，实时同步官方档期。</p>
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-steam-md bg-steam-bg/80 border border-steam-accent/20 text-steam-text-muted text-xs tracking-wide">
                            定时刷新缓存 · 自动生成分享长图
                        </span>
                        <span class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-steam-md bg-steam-bg/80 border border-steam-accent/20 text-steam-text-muted text-xs tracking-wide">
                            最后同步：{{FETCHED_AT}}
                        </span>
                    </div>
                </div>
            </header>

            <!-- Main Content -->
            <section class="relative p-6 lg:p-10 xl:p-12 rounded-steam-xl bg-steam-section border border-steam-accent/15 shadow-steam-section" role="main">

                <!-- Heading Row -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
                    <div class="flex flex-col gap-3">
                        <h2 class="text-xl lg:text-2xl font-bold tracking-widest uppercase m-0">限免目录</h2>
                        <p class="text-steam-text-muted text-sm leading-relaxed max-w-xl m-0">当前已收录 {{TOTAL_COUNT}} 条限免记录，可在下方切换平台查看详情。</p>
                    </div>
                    <a class="share-button inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-full border border-steam-accent/30 bg-steam-accent-gradient text-steam-text text-xs tracking-widest uppercase font-semibold no-underline transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_35px_rgba(102,192,244,0.25)] hover:border-steam-accent/40 disabled:cursor-not-allowed disabled:opacity-55 disabled:pointer-events-none min-h-[44px] min-w-[160px]"
                       data-share-button href="{{SHARE_BUTTON_URL}}" download="{{SHARE_BUTTON_FILENAME}}" rel="noopener"{{SHARE_BUTTON_DISABLED}}>
                        {{SHARE_BUTTON_LABEL}}
                    </a>
                </div>

                <!-- Tab Navigation - Mobile Horizontal Scroll -->
                <nav class="inline-flex items-center p-1.5 rounded-full border border-steam-accent/20 bg-steam-bg/80 gap-1.5 overflow-x-auto scrollbar-hide mb-8" role="tablist" aria-label="限免平台切换">
                    <button class="epic-freebies__tab is-active relative px-4 py-3 rounded-full border-none bg-transparent text-steam-text-muted text-xs tracking-widest uppercase cursor-pointer transition-all duration-200 hover:text-steam-text hover:-translate-y-0.5 flex items-center gap-2.5 whitespace-nowrap min-h-[44px]"
                            role="tab" aria-selected="true" aria-controls="free-panel-epic" data-tab="epic">
                        Epic 限免
                        <span class="epic-freebies__tab-badge min-w-[28px] px-2.5 py-1 rounded-full bg-steam-accent/20 text-steam-text text-xs tracking-wide text-center" data-badge="epic">{{TAB_BADGE_EPIC}}</span>
                    </button>
                    <button class="epic-freebies__tab relative px-4 py-3 rounded-full border-none bg-transparent text-steam-text-muted text-xs tracking-widest uppercase cursor-pointer transition-all duration-200 hover:text-steam-text hover:-translate-y-0.5 flex items-center gap-2.5 whitespace-nowrap min-h-[44px]"
                            role="tab" aria-selected="false" aria-controls="free-panel-steam" data-tab="steam">
                        Steam 限免
                        <span class="epic-freebies__tab-badge min-w-[28px] px-2.5 py-1 rounded-full bg-steam-accent/20 text-steam-text text-xs tracking-wide text-center" data-badge="steam">{{TAB_BADGE_STEAM}}</span>
                    </button>
                    <button class="epic-freebies__tab relative px-4 py-3 rounded-full border-none bg-transparent text-steam-text-muted text-xs tracking-widest uppercase cursor-pointer transition-all duration-200 hover:text-steam-text hover:-translate-y-0.5 flex items-center gap-2.5 whitespace-nowrap min-h-[44px]"
                            role="tab" aria-selected="false" aria-controls="free-panel-psn" data-tab="psn">
                        PlayStation 限免
                        <span class="epic-freebies__tab-badge min-w-[28px] px-2.5 py-1 rounded-full bg-steam-accent/20 text-steam-text text-xs tracking-wide text-center" data-badge="psn">{{TAB_BADGE_PSN}}</span>
                    </button>
                    <button class="epic-freebies__tab relative px-4 py-3 rounded-full border-none bg-transparent text-steam-text-muted text-xs tracking-widest uppercase cursor-pointer transition-all duration-200 hover:text-steam-text hover:-translate-y-0.5 flex items-center gap-2.5 whitespace-nowrap min-h-[44px]"
                            role="tab" aria-selected="false" aria-controls="free-panel-itad" data-tab="itad">
                        ITAD Giveaways
                        <span class="epic-freebies__tab-badge min-w-[28px] px-2.5 py-1 rounded-full bg-steam-accent/20 text-steam-text text-xs tracking-wide text-center" data-badge="itad">{{TAB_BADGE_ITAD}}</span>
                    </button>
                </nav>

                <!-- Tab Panels -->
                <div class="epic-freebies__panels">

                    <!-- Epic Panel -->
                    <div class="epic-freebies__panel is-active" role="tabpanel" id="free-panel-epic" data-panel="epic">
                        <!-- Epic Now -->
                        <div class="p-5 lg:p-8 rounded-steam-lg bg-steam-card border border-steam-accent/15 shadow-steam-card mb-6">
                            <header class="flex items-center justify-between gap-4 mb-5">
                                <h3 class="text-base lg:text-lg font-semibold tracking-wide m-0">EPIC 正在免费</h3>
                                <span class="epic-freebies__section-count px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase" data-count="now">{{EPIC_NOW_COUNT}}</span>
                            </header>
                            <div class="epic-freebies__section-body" data-section-body="now">
                                {{EPIC_NOW_CONTENT}}
                            </div>
                        </div>
                        <!-- Epic Upcoming -->
                        <div class="p-5 lg:p-8 rounded-steam-lg bg-steam-card border border-steam-accent/15 shadow-steam-card">
                            <header class="flex items-center justify-between gap-4 mb-5">
                                <h3 class="text-base lg:text-lg font-semibold tracking-wide m-0">EPIC 即将免费</h3>
                                <span class="epic-freebies__section-count px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase" data-count="upcoming">{{EPIC_UPCOMING_COUNT}}</span>
                            </header>
                            <div class="epic-freebies__section-body" data-section-body="upcoming">
                                {{EPIC_UPCOMING_CONTENT}}
                            </div>
                        </div>
                    </div>

                    <!-- Steam Panel -->
                    <div class="epic-freebies__panel" role="tabpanel" id="free-panel-steam" data-panel="steam">
                        <div class="p-5 lg:p-8 rounded-steam-lg bg-steam-card border border-steam-accent/15 shadow-steam-card">
                            <header class="flex items-center justify-between gap-4 mb-5">
                                <h3 class="text-base lg:text-lg font-semibold tracking-wide m-0">Steam 限免</h3>
                                <span class="epic-freebies__section-count px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase" data-count="steam">{{STEAM_COUNT}}</span>
                            </header>
                            <div class="epic-freebies__section-body" data-section-body="steam">
                                {{STEAM_CONTENT}}
                            </div>
                        </div>
                    </div>

                    <!-- PSN Panel -->
                    <div class="epic-freebies__panel" role="tabpanel" id="free-panel-psn" data-panel="psn">
                        <div class="p-5 lg:p-8 rounded-steam-lg bg-steam-card border border-steam-accent/15 shadow-steam-card">
                            <header class="flex items-center justify-between gap-4 mb-5">
                                <h3 class="text-base lg:text-lg font-semibold tracking-wide m-0">PlayStation 本月会员免费</h3>
                                <span class="epic-freebies__section-count px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase" data-count="psn">{{PSN_COUNT}}</span>
                            </header>
                            <div class="epic-freebies__section-body" data-section-body="psn">
                                {{PSN_CONTENT}}
                            </div>
                        </div>
                    </div>

                    <!-- ITAD Panel -->
                    <div class="epic-freebies__panel" role="tabpanel" id="free-panel-itad" data-panel="itad">
                        <div class="p-5 lg:p-8 rounded-steam-lg bg-steam-card border border-steam-accent/15 shadow-steam-card">
                            <header class="flex items-center justify-between gap-4 mb-5">
                                <h3 class="text-base lg:text-lg font-semibold tracking-wide m-0">ITAD Bundle Giveaways</h3>
                                <span class="epic-freebies__section-count px-3.5 py-1.5 rounded-full bg-steam-accent/20 text-steam-accent text-xs tracking-widest uppercase" data-count="itad">{{ITAD_COUNT}}</span>
                            </header>
                            <div class="epic-freebies__section-body" data-section-body="itad">
                                {{ITAD_CONTENT}}
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- Footer -->
            <footer class="mt-12 pt-6 pb-4 border-t border-steam-accent/20 text-steam-text-muted text-xs tracking-wide flex flex-wrap justify-center items-center gap-x-5 gap-y-3 text-center">
                <img class="w-8 h-8 rounded-full object-cover border border-steam-accent/40" src="https://avatars.githubusercontent.com/u/63827263?v=4" alt="Nodesire7 头像" width="32" height="32">
                <div class="flex flex-wrap justify-center items-center gap-x-4 gap-y-2">
                    <span>作者：<a href="https://github.com/nodesire7/" target="_blank" rel="noopener noreferrer" class="text-steam-accent no-underline hover:underline">Nodesire7</a></span>
                    <span>邮箱：<a href="mailto:amocnfk@gmail.com" class="text-steam-accent no-underline hover:underline">amocnfk@gmail.com</a></span>
                    <span>仓库：<a href="https://github.com/nodesire7/FreeGame-info" target="_blank" rel="noopener noreferrer" class="text-steam-accent no-underline hover:underline">FreeGame-info</a></span>
                    <span>数据源：<a href="https://isthereanydeal.com/" target="_blank" rel="noopener noreferrer" class="text-steam-accent no-underline hover:underline">IsThereAnyDeal</a></span>
                    {{ARCHIVE_LINKS}}
                </div>
            </footer>
        </div>
    </div>

    <script type="application/json" id="share-payload">{{SHARE_DATA_JSON}}</script>
    <script>
    {{CLIENT_SCRIPT}}
    </script>
</body>
</html>
